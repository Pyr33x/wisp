# goflare project identity (Cloudflare project name; the action sets it from WORKER_NAME in CI).
PROJECT_NAME=wisp-gateway
# Worker script name.
WORKER_NAME=wisp-gateway
# Public custom domain the gateway is served on; goflare attaches it and adds a zone rate-limit rule.
DOMAIN=wisp.example.com
# Binding name the Worker reads D1 through (d1.NewEdge("DB")).
D1_BINDING=DB
# D1 database name; goflare resolves its ID at deploy (replaces D1_DATABASE_ID).
D1_NAME=wisp-gateway
# Workers compatibility date sent with every deploy.
COMPATIBILITY_DATE=2026-08-01
# Non-secret runtime var BASE_URL: this Worker's public origin (links to it are refused as redirect loops).
# goflare reads VARS from .env as ONE line, so only one var fits here; CI's deploy workflow passes all three
# (BASE_URL, LINK_URL, ANALYTICS_URL) through the action's multi-line `vars` input from GitHub repository variables.
VARS=BASE_URL=https://wisp.example.com
# Internal Worker origins (workers.dev), set in CI as repository variables WISP_LINK_URL / WISP_ANALYTICS_URL.
# LINK_URL=https://wisp-link.YOUR-SUBDOMAIN.workers.dev
# ANALYTICS_URL=https://wisp-analytics.YOUR-SUBDOMAIN.workers.dev
# Secrets are NOT set here. Worker secrets (dashboard): ADMIN_TOKEN, INTERNAL_SECRET. GitHub secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
