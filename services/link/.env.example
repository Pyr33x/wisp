# goflare project identity (Cloudflare project name; the action sets it from WORKER_NAME in CI).
PROJECT_NAME=wisp-link
# Worker script name.
WORKER_NAME=wisp-link
# Binding name the Worker reads D1 through (d1.NewEdge("DB")).
D1_BINDING=DB
# D1 database name; goflare resolves its ID at deploy (replaces D1_DATABASE_ID).
D1_NAME=wisp-links
# Workers compatibility date sent with every deploy.
COMPATIBILITY_DATE=2026-08-01
# Non-secret runtime vars: BASE_URL is the gateway's public origin, used to build every short URL.
VARS=BASE_URL=https://wisp.example.com
# Secrets are NOT set here. Worker secret (dashboard): INTERNAL_SECRET. GitHub secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID.
